generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resident {
  id                           String       @id @default(cuid())
  name                         String
  imageUrl                     String
  room                         String
  status                       String
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  adlNeeds                     String[]
  admissionDate                DateTime?    @default(now())
  assignedCNA                  String?
  dateOfBirth                  DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  notes                        String?
  adlLogs                      ADLLog[]
  allergies                    Allergy[]
  conditions                   Condition[]
  dnrStatus                    DNRStatus?
  medications                  Medication[]
  specialists                  Specialist[]
}

model ADLLog {
  id           String   @id @default(cuid())
  residentId   String
  activityType String
  assistance   String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resident     Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
}

model Allergy {
  id         String   @id @default(cuid())
  residentId String
  name       String
  severity   String
  reaction   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Condition {
  id            String    @id @default(cuid())
  residentId    String
  name          String
  diagnosedDate DateTime?
  status        String
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resident      Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Medication {
  id                 String    @id @default(cuid())
  residentId         String
  name               String
  dosage             String
  frequency          String
  instructions       String?
  startDate          DateTime
  endDate            DateTime?
  status             String
  discontinuedReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resident           Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Specialist {
  id         String   @id @default(cuid())
  residentId String
  name       String
  specialty  String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model DNRStatus {
  id            String    @id @default(cuid())
  residentId    String    @unique
  hasDNR        Boolean   @default(false)
  hasDNI        Boolean   @default(false)
  dnrDate       DateTime?
  dniDate       DateTime?
  physicianName String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resident      Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
}
