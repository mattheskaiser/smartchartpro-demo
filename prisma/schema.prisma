generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  CNA
}

// User authentication and accounts
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String // hashed with bcrypt
  role               Role      @default(CNA)
  cnaId              String?   @unique // Link to CNA record (null for admins)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  cna              Cna?              @relation(fields: [cnaId], references: [id], onDelete: SetNull)
  chartingSessions ChartingSession[]
  createdReports   ChartingReport[]  @relation("ReportCreator")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([role, isActive]) // Composite index for admin queries filtering by role and status
}

// Active charting sessions for CNAs
model ChartingSession {
  id           String    @id @default(cuid())
  userId       String
  cnaId        String
  residentIds  String[] // Array of resident IDs in this session
  startTime    DateTime  @default(now())
  endTime      DateTime?
  isActive     Boolean   @default(true)
  currentStep  String    @default("start") // "start", "adls", "review"
  chartingData Json? // Store in-progress charting data
  reportId     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cna    Cna             @relation(fields: [cnaId], references: [id], onDelete: Cascade)
  report ChartingReport? @relation(fields: [reportId], references: [id])

  @@index([userId, isActive])
  @@index([cnaId, isActive])
  @@index([isActive])
  @@index([isActive, startTime]) // Composite index for admin dashboard queries
}

model Resident {
  id                           String               @id @default(cuid())
  name                         String
  imageData                    String? // Base64 encoded image data
  room                         String
  status                       String
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  adlNeeds                     String[]
  admissionDate                DateTime?            @default(now())
  assignedCNA                  String?
  dateOfBirth                  DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  notes                        String?
  adlLogs                      ADLLog[]
  allergies                    Allergy[]
  conditions                   Condition[]
  dnrStatus                    DNRStatus?
  medications                  Medication[]
  specialists                  Specialist[]
  residentAssignments          ResidentAssignment[] // Shift assignments

  @@index([status]) // Index for filtering active/inactive residents
  @@index([assignedCNA]) // Index for CNA-resident mapping queries
}

model ADLLog {
  id           String   @id @default(cuid())
  residentId   String
  activityType String
  assistance   String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resident     Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
}

model Allergy {
  id         String   @id @default(cuid())
  residentId String
  name       String
  severity   String
  reaction   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Condition {
  id            String    @id @default(cuid())
  residentId    String
  name          String
  diagnosedDate DateTime?
  status        String
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resident      Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Medication {
  id                 String    @id @default(cuid())
  residentId         String
  name               String
  dosage             String
  frequency          String
  instructions       String?
  startDate          DateTime
  endDate            DateTime?
  status             String
  discontinuedReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resident           Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Specialist {
  id         String   @id @default(cuid())
  residentId String
  name       String
  specialty  String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model DNRStatus {
  id            String    @id @default(cuid())
  residentId    String    @unique
  hasDNR        Boolean   @default(false)
  hasDNI        Boolean   @default(false)
  dnrDate       DateTime?
  dniDate       DateTime?
  physicianName String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resident      Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model Cna {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  phone               String?
  status              String    @default("active")
  imageData           String? // Base64 encoded image data
  hireDate            DateTime?
  certificationNumber String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Shift management relationships
  availableShifts CnaAvailability[] // Which shifts they can work
  assignedShifts  ShiftAssignment[] // Actual shift assignments
  timeEntries     TimeEntry[] // Clock in/out records
  chartingReports ChartingReport[] // Charting reports created by this CNA

  // Authentication relationship
  user             User? // User account for this CNA
  chartingSessions ChartingSession[] // Active charting sessions
}

// CNA availability - which shifts a CNA can work
model CnaAvailability {
  id        String   @id @default(cuid())
  cnaId     String
  shiftType String // "Morning", "Evening", "Night"
  dayOfWeek Int // 0-6 (Sunday-Saturday)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cna Cna @relation(fields: [cnaId], references: [id], onDelete: Cascade)

  @@unique([cnaId, shiftType, dayOfWeek])
  @@index([cnaId])
}

// Daily shift assignments
model ShiftAssignment {
  id        String    @id @default(cuid())
  date      DateTime // The specific date for this shift
  shiftType String // "Morning", "Evening", "Night"
  cnaId     String? // Assigned CNA (nullable for unassigned shifts)
  status    String    @default("scheduled") // "scheduled", "in_progress", "completed", "cancelled"
  startTime DateTime?
  endTime   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cna                 Cna?                 @relation(fields: [cnaId], references: [id])
  residentAssignments ResidentAssignment[] // Which residents are assigned to this shift

  @@unique([date, shiftType]) // Only one assignment per shift per day
  @@index([date])
  @@index([cnaId])
}

// Resident assignments to specific shifts
model ResidentAssignment {
  id                String   @id @default(cuid())
  shiftAssignmentId String
  residentId        String
  createdAt         DateTime @default(now())

  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)
  resident        Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([shiftAssignmentId, residentId])
  @@index([shiftAssignmentId])
  @@index([residentId])
}

// Shift templates/definitions for the facility
model ShiftTemplate {
  id          String   @id @default(cuid())
  name        String // "Morning", "Day", "Evening", "Night", etc.
  startTime   String // "06:00" (24-hour format)
  endTime     String // "14:00" (24-hour format)
  isActive    Boolean  @default(true)
  color       String? // Hex color for UI display
  description String?
  sortOrder   Int      @default(0) // For ordering in UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
  @@index([isActive, sortOrder])
}

// Time tracking for CNAs
model TimeEntry {
  id                String    @id @default(cuid())
  cnaId             String
  shiftAssignmentId String?
  clockIn           DateTime
  clockOut          DateTime?
  breakStart        DateTime?
  breakEnd          DateTime?
  totalHours        Float?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cna Cna @relation(fields: [cnaId], references: [id], onDelete: Cascade)

  @@index([cnaId])
  @@index([clockIn])
}

// Charting reports - completed ADL charting sessions
model ChartingReport {
  id               String   @id @default(cuid())
  reportDate       DateTime // Date of the charting session
  sessionStartTime DateTime // When charting started
  sessionEndTime   DateTime // When charting ended

  // CNA information
  cnaId            String?
  cnaName          String?
  cnaCertification String?

  // User who created this report
  createdById String?

  // Summary statistics
  totalResidents  Int
  totalActivities Int

  // Report status and review
  status     String    @default("pending") // "pending", "reviewed", "archived"
  reviewedBy String? // Admin who reviewed
  reviewedAt DateTime?
  notes      String? // Admin notes

  // Actual charting data stored as JSON
  residentsData Json // Array of residents: [{id, name, room, status, imageData}]
  entriesData   Json // Array of ADL entries: [{residentId, activityType, assistance, timestamp, notes}]

  // Generated PDF stored as base64
  pdfData String? @db.Text // Base64 encoded PDF file

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cna       Cna?             @relation(fields: [cnaId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  session   ChartingSession? // Linked session

  @@index([reportDate])
  @@index([cnaId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt]) // Composite index for filtering and sorting reports
  @@index([cnaId, reportDate]) // Composite index for CNA-specific report queries
}
