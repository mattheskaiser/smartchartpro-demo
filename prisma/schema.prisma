generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resident {
  id                           String                @id @default(cuid())
  name                         String
  imageData                    String?               // Base64 encoded image data
  room                         String
  status                       String
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  adlNeeds                     String[]
  admissionDate                DateTime?             @default(now())
  assignedCNA                  String?
  dateOfBirth                  DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  notes                        String?
  adlLogs                      ADLLog[]
  allergies                    Allergy[]
  conditions                   Condition[]
  dnrStatus                    DNRStatus?
  medications                  Medication[]
  specialists                  Specialist[]
  residentAssignments          ResidentAssignment[]  // Shift assignments
}

model ADLLog {
  id           String   @id @default(cuid())
  residentId   String
  activityType String
  assistance   String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resident     Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
}

model Allergy {
  id         String   @id @default(cuid())
  residentId String
  name       String
  severity   String
  reaction   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Condition {
  id            String    @id @default(cuid())
  residentId    String
  name          String
  diagnosedDate DateTime?
  status        String
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resident      Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Medication {
  id                 String    @id @default(cuid())
  residentId         String
  name               String
  dosage             String
  frequency          String
  instructions       String?
  startDate          DateTime
  endDate            DateTime?
  status             String
  discontinuedReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resident           Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model Specialist {
  id         String   @id @default(cuid())
  residentId String
  name       String
  specialty  String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

model DNRStatus {
  id            String    @id @default(cuid())
  residentId    String    @unique
  hasDNR        Boolean   @default(false)
  hasDNI        Boolean   @default(false)
  dnrDate       DateTime?
  dniDate       DateTime?
  physicianName String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resident      Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model Cna {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  phone               String?
  status              String              @default("active")
  imageData           String?             // Base64 encoded image data
  hireDate            DateTime?
  certificationNumber String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  // Shift management relationships
  availableShifts     CnaAvailability[]   // Which shifts they can work
  assignedShifts      ShiftAssignment[]   // Actual shift assignments
  timeEntries         TimeEntry[]         // Clock in/out records
}

// CNA availability - which shifts a CNA can work
model CnaAvailability {
  id        String   @id @default(cuid())
  cnaId     String
  shiftType String   // "Morning", "Evening", "Night"
  dayOfWeek Int      // 0-6 (Sunday-Saturday)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  cna Cna @relation(fields: [cnaId], references: [id], onDelete: Cascade)
  
  @@unique([cnaId, shiftType, dayOfWeek])
  @@index([cnaId])
}

// Daily shift assignments
model ShiftAssignment {
  id          String   @id @default(cuid())
  date        DateTime // The specific date for this shift
  shiftType   String   // "Morning", "Evening", "Night"
  cnaId       String?  // Assigned CNA (nullable for unassigned shifts)
  status      String   @default("scheduled") // "scheduled", "in_progress", "completed", "cancelled"
  startTime   DateTime?
  endTime     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cna               Cna?                    @relation(fields: [cnaId], references: [id])
  residentAssignments ResidentAssignment[] // Which residents are assigned to this shift
  
  @@unique([date, shiftType]) // Only one assignment per shift per day
  @@index([date])
  @@index([cnaId])
}

// Resident assignments to specific shifts
model ResidentAssignment {
  id              String          @id @default(cuid())
  shiftAssignmentId String
  residentId      String
  createdAt       DateTime        @default(now())
  
  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)
  resident        Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  
  @@unique([shiftAssignmentId, residentId])
  @@index([shiftAssignmentId])
  @@index([residentId])
}

// Time tracking for CNAs
model TimeEntry {
  id        String    @id @default(cuid())
  cnaId     String
  shiftAssignmentId String?
  clockIn   DateTime
  clockOut  DateTime?
  breakStart DateTime?
  breakEnd   DateTime?
  totalHours Float?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  cna Cna @relation(fields: [cnaId], references: [id], onDelete: Cascade)
  
  @@index([cnaId])
  @@index([clockIn])
}
